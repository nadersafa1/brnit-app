# Copy to `.env` for local `docker compose up --build`.
# On Dokploy, set these on the Compose application (not committed).
#
# Local only: create the external network once:
#   docker network create dokploy-network

# --- Required ---
DATABASE_URL=postgresql://user:password@host:5432/brnit
REDIS_PASSWORD=change-me-to-a-strong-random-password
BETTER_AUTH_SECRET=minimum-thirty-two-character-secret-here
BETTER_AUTH_URL=https://api-staging.brnit.app
# Comma-separated; trailing slashes are stripped, each entry must be a valid URL.
CORS_ORIGIN=https://app-staging.brnit.app
NODE_ENV=production

# --- Optional local port mapping (docker-compose.local.yml) ---
POSTGRES_HOST_PORT=55432
API_PORT=13000

# --- OAuth (optional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=com.yourcompany.yourapp.si
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# Apple Sign In — quoted PEM with \n escapes
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Must match apps/native app.json ios.bundleIdentifier
# APPLE_APP_BUNDLE_IDENTIFIER=

# --- Cloudinary (optional; required for food-item / assessment / profile images) ---
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Email (optional; required for verification, password reset, invitations) ---
# NODEMAILER_HOST=smtp.example.com
# NODEMAILER_USER=noreply@example.com
# NODEMAILER_APP_PASSWORD=
# NODEMAILER_PORT=465

# --- Push notifications (optional; required to send FCM from api/worker) ---
# FIREBASE_PROJECT_ID=
# Use base64 in compose .env (multiline JSON breaks docker compose env-file parsing):
# FIREBASE_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...

# --- Observability / audit (optional) ---
# Writes an audit row for every POST/PUT/PATCH/DELETE. Only the literal "true" enables it.
# AUDIT_LOG_DB_ENABLED=false
# trace | debug | info | warn | error | fatal | silent (default: debug in dev, info otherwise)
# LOG_LEVEL=info

# --- Business tuning (optional; defaults shown) ---
# Days in the past a member may still log a consumption for. Clamped 0-365.
# MAX_CONSUMPTION_PAST_DAYS=2
# Days after a diet plan assignment ends that logging stays open. Minimum 0.
# DIET_PLAN_CONSUMPTION_GRACE_DAYS=2
# Macro tolerance (%) for food-item alternatives. Each clamped 1-100.
# ALTERNATIVES_TOLERANCE_CAL_PCT=15
# ALTERNATIVES_TOLERANCE_PROTEIN_PCT=15
# ALTERNATIVES_TOLERANCE_CARBS_PCT=15
# ALTERNATIVES_TOLERANCE_FAT_PCT=15

# --- OpenTelemetry (optional) ---
# Owned by the OTel SDK, not @brnit/env. Leave OTEL_EXPORTER_OTLP_ENDPOINT unset
# to disable instrumentation entirely.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(user:password)>
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_DEPLOYMENT_ENVIRONMENT=staging
# OTEL_API_SERVICE_NAME=brnit-api-staging
# OTEL_WORKER_SERVICE_NAME=brnit-worker-staging

# --- Local Postgres (docker-compose.local.yml; defaults shown) ---
# POSTGRES_USER=brnit
# POSTGRES_PASSWORD=brnit
# POSTGRES_DB=brnit

# --- Web image build args (Dockerfile.web) ---
# Vite inlines these at build time; pass them as --build-arg, not runtime env.
# VITE_SERVER_URL=https://api-staging.brnit.app
# VITE_API_VERSION=1

# PORT is set per-service in docker-compose.yml (api: 3000).
# REDIS_URL is composed inside docker-compose.yml and must never be set here:
#   redis://:${REDIS_PASSWORD}@redis:6379
