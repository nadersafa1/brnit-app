{
  "name": "brnit",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/expo": "1.5.5",
      "@types/bun": "^1.3.4",
      "@types/react-dom": "^19.2.3",
      "better-auth": "1.5.5",
      "dotenv": "^17.2.2",
      "drizzle-kit": "^0.31.8",
      "drizzle-orm": "^0.45.1",
      "lucide-react": "^0.546.0",
      "luxon": "^3.7.2",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.5",
      "tailwindcss": "^4.1.18",
      "zod": "^4.1.13"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "dev:workers": "turbo -F server worker:background",
    "db:push": "turbo -F @brnit/db db:push",
    "db:studio": "turbo -F @brnit/db db:studio",
    "db:generate": "turbo -F @brnit/db db:generate",
    "db:migrate": "turbo -F @brnit/db db:migrate",
    "db:seed": "turbo -F @brnit/db db:seed",
    "db:deploy": "turbo -F @brnit/db db:deploy",
    "auth:generate-schema": "bunx @better-auth/cli@latest generate --config ./packages/auth/src/index.ts --output ./packages/db/src/schema/auth-better-auth-generated.ts --yes",
    "compose:up": "docker compose -f docker-compose.yml -f docker-compose.local.yml up --build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip",
    "test": "turbo test"
  },
  "dependencies": {
    "@brnit/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@brnit/config": "workspace:*",
    "@types/bun": "catalog:",
    "knip": "^6.12.2",
    "turbo": "^2.8.12",
    "typescript": "^6.0.3",
    "ultracite": "7.6.0"
  },
  "packageManager": "bun@1.3.12",
  "engines": {
    "bun": ">=1.3.0"
  }
}
