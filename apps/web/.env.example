# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Auth (better-auth)
BETTER_AUTH_SECRET=your-secret
BETTER_AUTH_URL=https://your-app.com
CORS_ORIGIN=https://your-app.com

# Google OAuth (for social sign-in)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple Sign In (web: Service ID as APPLE_CLIENT_ID; Return URL e.g. https://your-app.com/api/auth/callback/apple)
# APPLE_APP_BUNDLE_IDENTIFIER=com.yourcompany.app (set for Expo iOS native idToken; match apps/native app.json ios.bundleIdentifier)
APPLE_CLIENT_ID=com.yourcompany.yourapp.si
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Cloudinary (for body composition assessment images)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Diet plan meal consumption: days after assignment end date that logging is allowed (default 2)
DIET_PLAN_CONSUMPTION_GRACE_DAYS=2

# Email (nodemailer) – required for email verification and password reset
NODEMAILER_HOST=smtp.example.com
NODEMAILER_USER=your-email@example.com
NODEMAILER_APP_PASSWORD=your-app-password
# NODEMAILER_PORT=465
