# apps/web is a Vite SPA. Only VITE_* reaches the browser, and Vite inlines
# these at BUILD time — a value set only in the runtime container never lands in
# the bundle (see the ARG block in Dockerfile.web).

# Origin of the Express API this SPA talks to. Also the better-auth base URL:
# the auth client appends /api/auth itself.
VITE_SERVER_URL=http://localhost:3000

# API major version. Requests to /api/... are rewritten to /api/v{n}/...
# (better-auth stays unversioned at /api/auth/*).
VITE_API_VERSION=1
