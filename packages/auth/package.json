{
  "name": "@brnit/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./permissions": {
      "types": "./src/permissions.ts",
      "import": "./src/permissions.ts",
      "default": "./src/permissions.ts"
    },
    "./role-ranks": {
      "types": "./src/role-ranks.ts",
      "import": "./src/role-ranks.ts",
      "default": "./src/role-ranks.ts"
    },
    "./authorization": {
      "types": "./src/authorization.ts",
      "import": "./src/authorization.ts",
      "default": "./src/authorization.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test --preload ../../test-setup.ts src"
  },
  "dependencies": {
    "@better-auth/expo": "catalog:",
    "@brnit/brand": "workspace:*",
    "@brnit/db": "workspace:*",
    "@brnit/domain": "workspace:*",
    "@brnit/env": "workspace:*",
    "@brnit/logger": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "jose": "^6.2.2",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "@brnit/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/nodemailer": "^7.0.3",
    "typescript": "^6.0.3"
  }
}
