{
  "name": "@brnit/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./schema/*": {
      "types": "./src/schema/*.ts",
      "import": "./src/schema/*.ts",
      "default": "./src/schema/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:deploy": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/seed.ts",
    "db:deploy": "bun run db:migrate:deploy",
    "check-types": "tsc --noEmit",
    "test": "bun test --preload ../../test-setup.ts"
  },
  "dependencies": {
    "@brnit/domain": "workspace:*",
    "@brnit/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "drizzle-seed": "^0.3.1",
    "pg": "^8.17.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@brnit/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "catalog:",
    "typescript": "^6.0.3"
  }
}
