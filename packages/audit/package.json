{
  "name": "@brnit/audit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "import": "./src/constants.ts",
      "default": "./src/constants.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "import": "./src/schemas.ts",
      "default": "./src/schemas.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test --preload ../../test-setup.ts src"
  },
  "dependencies": {
    "@brnit/db": "workspace:*",
    "@brnit/logger": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@brnit/config": "workspace:*",
    "typescript": "^6.0.3"
  }
}
