# Vite SPA (TanStack Router) served by nginx. Build context = monorepo root,
# same as Dockerfile for the API.
#
# Dokploy: new application, repo root as build path, Dockerfile path = Dockerfile.web
#
# Required build-time arg (better-auth client + the web API client use this URL):
#   VITE_SERVER_URL=https://api.yourdomain.com
# Optional build-time arg:
#   VITE_API_VERSION=1
# Vite inlines VITE_* at build time, so these must be set as **build args**, not
# only as runtime env — a runtime-only value never reaches the bundle.
#
# Requires apps/web/nginx.conf to exist. A client-side router needs the
# history-API fallback, so that file must contain at least:
#   server {
#     listen 80;
#     root /usr/share/nginx/html;
#     index index.html;
#     location / { try_files $uri $uri/ /index.html; }
#   }

ARG BUN_VERSION=1.3.12

FROM oven/bun:${BUN_VERSION} AS pruner
WORKDIR /app

ENV CI=true

COPY . .

RUN bunx turbo prune --scope=web --docker


FROM oven/bun:${BUN_VERSION} AS builder
WORKDIR /app

ENV CI=true

COPY --from=pruner /app/out/json/ .

ARG VITE_SERVER_URL
ENV VITE_SERVER_URL=${VITE_SERVER_URL}

ARG VITE_API_VERSION=1
ENV VITE_API_VERSION=${VITE_API_VERSION}

RUN bun install --ignore-scripts

COPY --from=pruner /app/out/full/ .

RUN bun run turbo build --filter=web


FROM nginx:alpine AS runner

COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
